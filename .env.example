# Test Agent Environment Configuration

# Authentication (required)
TESTAGENT_AGENT_TOKEN=AGENT-SECRET-TOKEN

# API Connection
TESTAGENT_FULCRUM_API_URL=http://localhost:3000

# Simulation Intervals (time.Duration format)
TESTAGENT_VM_OPERATION_INTERVAL=5s
TESTAGENT_JOB_POLL_INTERVAL=5s
TESTAGENT_METRIC_REPORT_INTERVAL=30s

# Operation Parameters
TESTAGENT_OPERATION_DELAY_MIN=2s
TESTAGENT_OPERATION_DELAY_MAX=10s
TESTAGENT_ERROR_RATE=0.05